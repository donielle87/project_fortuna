# Project Fortuna environment configuration (example).
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# Root data directory (defaults to ./data relative to repo root)
FORTUNA_DATA_DIR=data

# Optional: Socrata app token for data.ny.gov draw endpoints (raises rate limits).
# Leave empty for unauthenticated (still functional, lower rate limit).
NYDATA_APP_TOKEN=

# HTTP fetch settings for provenance/ingestion
FORTUNA_HTTP_TIMEOUT=30
FORTUNA_USER_AGENT=project-fortuna/0.1 (research; contact: project owner)
